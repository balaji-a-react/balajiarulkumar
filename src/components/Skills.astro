---
const skillCategories = [
  {
    title: 'Languages',
    skills: ['HTML', 'CSS', 'JavaScript', 'TypeScript'],
  },
  {
    title: 'Frameworks',
    skills: ['React JS', 'Astro', 'Tailwind CSS'],
  },
  {
    title: 'State Management & APIs',
    skills: ['Redux', 'Context API', 'Zustand', 'GraphQL', 'RESTful APIs'],
  },
  {
    title: 'Performance & SEO',
    skills: ['Lazy Loading', 'CSR', 'ISR', 'SSR'],
  },
  {
    title: 'Tools & Version Control',
    skills: ['VS Code', 'Git', 'GitHub', 'GitLab', 'Vite', 'Webpack'],
  },
];
---

<section id="skills" class="py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-white text-center mb-4 reveal">
      Technical Skills
    </h2>
    <div class="w-16 h-1 bg-primary mx-auto mb-12 reveal"></div>

    <div class="space-y-8">
      {skillCategories.map(category => (
        <div class="reveal">
          <h3 class="text-lg font-semibold text-white mb-4">{category.title}</h3>
          <div class="flex flex-wrap gap-3">
            {category.skills.map(skill => (
              <span class="px-4 py-2 rounded-full text-sm font-medium bg-primary/10 text-primary-light border border-primary/20 hover:bg-primary/20 hover:border-primary/40 transition-all duration-200">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
