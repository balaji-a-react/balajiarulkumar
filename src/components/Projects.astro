---
import { formatRange } from '../utils/dates';

interface Project {
  title: string;
  category: 'ox' | 'independent';
  featured?: boolean;
  link?: string;
  org?: string;
  start?: string;
  end?: string;
  desc: string;
  contribution: string;
  tags: string[];
}

const projects: Project[] = [
  {
    title: 'AsherGo — Malaysian ERP System',
    category: 'independent',
    featured: true,
    link: 'https://ashergo.com',
    start: '2026-07',
    end: '2026-09',
    desc: 'Contributed to an existing ERP application for Ria Kistana, Malaysia, by implementing the Leave Management module, including leave application forms, leave listings, approval workflows, and REST API integration.',
    contribution: 'Owned the Leave Management module on the frontend — leave application forms, listings, and approval workflows with REST API integration and Zod validation.',
    tags: ['React.js', 'TypeScript', 'Tailwind CSS', 'REST APIs', 'Zod'],
  },
  {
    title: 'OX BEMA',
    category: 'ox',
    featured: true,
    link: 'https://app.oxbema.com',
    start: '2025-02',
    end: '2025-12',
    desc: 'Comprehensive employee management system designed to streamline and simplify the management of employee details, including personal information, leave, project assignments, team and recruitment management.',
    contribution: 'Built reusable React components across employee, recruitment, leave, and project modules, integrating GraphQL with Apollo Client and shared state via Zustand and Context API.',
    tags: ['React.js', 'TypeScript', 'Tailwind CSS', 'Context API', 'Zustand', 'GraphQL', 'Apollo Client'],
  },
  {
    title: 'OX AGRY',
    category: 'ox',
    featured: true,
    link: 'https://www.oxagry.com',
    start: '2024-05',
    end: '2025-02',
    desc: 'Dynamic and innovative AgriTech platform dedicated to providing cutting-edge agricultural solutions. Empowering farmers and agricultural businesses with the latest technology and insights to enhance productivity, sustainability, and profitability.',
    contribution: 'Developed responsive UI modules for farm management and online transactions, integrating GraphQL, Google Maps, and PayU/Cashfree payment flows.',
    tags: ['React.js', 'TypeScript', 'Tailwind CSS', 'Context API', 'Zustand', 'GraphQL', 'Apollo Client', 'Google Maps', 'PayU', 'Cashfree'],
  },
  {
    title: 'Murugu Tamil Payilagam — Educational Institute Website',
    category: 'independent',
    link: 'https://murugutamilpayilagam.com',
    start: '2026-05',
    end: '2026-06',
    desc: 'Independently developed a responsive website for a Tamil educational institute, presenting coaching programs, course information, and enrollment details.',
    contribution: 'Built the responsive UI for programs, course information, and enrollment sections using reusable Astro components.',
    tags: ['Astro', 'TypeScript', 'Tailwind CSS'],
  },
  {
    title: 'Hashvith Naturals — Agricultural Products Website',
    category: 'independent',
    link: 'https://hashvithnaturals.com',
    start: '2026-01',
    end: '2026-04',
    desc: 'Independently developed a responsive website for a natural agricultural products brand, showcasing products and business information through reusable UI components.',
    contribution: 'Developed reusable UI components and product/business sections for a responsive brand website.',
    tags: ['Astro', 'TypeScript', 'Tailwind CSS'],
  },
  {
    title: 'OX Group Corporate Website',
    category: 'ox',
    link: 'https://oxgroup.in',
    start: '2025-05',
    end: '2025-12',
    desc: 'High-performance corporate website for OX Group built as a static site using Astro. Led a team of 3 developers.',
    contribution: 'Led a team of 3 developers to deliver the Astro-based corporate site, focusing on responsive layout and performance.',
    tags: ['Astro', 'JavaScript', 'Tailwind CSS'],
  },
  {
    title: 'OX Softwares Corporate Website',
    category: 'ox',
    link: 'https://oxsoftwares.com',
    start: '2025-05',
    end: '2025-12',
    desc: 'Company website showcasing services, portfolio, and team info with responsive design and optimal performance.',
    contribution: 'Built the services, portfolio, and team pages with responsive, component-driven Astro layouts.',
    tags: ['Astro', 'JavaScript', 'Tailwind CSS'],
  },
  {
    title: 'Gowtham Lodge',
    category: 'independent',
    link: 'https://gowthamlodge.com',
    start: '2025-05',
    end: '2025-12',
    desc: 'Hospitality website featuring room bookings, amenities showcase, and location details with user-friendly navigation.',
    contribution: 'Delivered a responsive hospitality site with room booking, amenities, and location sections.',
    tags: ['Astro', 'JavaScript', 'Tailwind CSS'],
  },
  // {
  //   title: 'Microservices-Based E-commerce Platform',
  //   category: 'independent',
  //   org: 'Freelance',
  //   link: '',
  //   desc: 'Developed a scalable React frontend for an enterprise E-commerce platform following a microservices architecture, integrating independently managed backend services through REST APIs. Designed and built a 15+ component reusable UI library and implemented pixel-perfect Figma designs, contributing to a modular, maintainable, and scalable frontend architecture.',
  //   contribution: 'Built a 15+ component reusable UI library and implemented pixel-perfect Figma designs for a modular, scalable frontend.',
  //   tags: ['React', 'TypeScript', 'Tailwind CSS', 'GraphQL', 'Zustand', 'Context API'],
  // },
];

const sortKey = (project: Project) =>
  project.end ? Number(project.end.replace('-', '')) : -1;

const featuredProjects = [...projects]
  .filter((project) => project.featured)
  .sort((a, b) => sortKey(b) - sortKey(a));

const otherProjects = [...projects]
  .filter((project) => !project.featured)
  .sort((a, b) => sortKey(b) - sortKey(a));

const orderedProjects = [...featuredProjects, ...otherProjects];

const filters = [
  { value: 'all', label: 'All' },
  { value: 'ox', label: 'OX Softwares' },
  { value: 'independent', label: 'Independent / Freelance' },
];

const keywords = [
  'Microservices',
  'Leave Management',
  'ERP',
  'React.js',
  'React',
  'TypeScript',
  'Tailwind CSS',
  'GraphQL',
  'Zustand',
  'Context API',
  'Astro',
  'JavaScript',
  'REST APIs',
  'REST API',
  'Zod',
];

const escapeHtml = (str: string) =>
  str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const escapeRegExp = (str: string) => str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

const highlight = (text: string) => {
  let result = escapeHtml(text);
  const matches: string[] = [];
  const sorted = [...keywords].sort((a, b) => b.length - a.length);

  sorted.forEach((keyword) => {
    const pattern = new RegExp(`(?<![A-Za-z0-9])${escapeRegExp(keyword)}(?![A-Za-z0-9])`, 'g');
    result = result.replace(pattern, (match) => {
      matches.push(match);
      return `\u0000${matches.length - 1}\u0000`;
    });
  });

  return result.replace(
    /\u0000(\d+)\u0000/g,
    (_, index) =>
      `<span class="text-primary-light font-medium">${matches[Number(index)]}</span>`
  );
};
---

<section id="projects" class="py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-white text-center mb-4 reveal">
      Projects
    </h2>
    <div class="w-16 h-1 bg-primary mx-auto mb-12 reveal"></div>

    <div class="flex flex-wrap justify-center gap-3 mb-12 reveal" role="group" aria-label="Filter projects">
      {filters.map((filter, index) => (
        <button
          type="button"
          class={`filter-btn${index === 0 ? ' active' : ''}`}
          data-filter={filter.value}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {filter.label}
        </button>
      ))}
    </div>

    <p class="sr-only" aria-live="polite" id="project-status"></p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {orderedProjects.map(project => (
        <div
          class:list={[
            'glass-card p-6 flex flex-col reveal',
            project.featured && 'border-primary/40 ring-1 ring-primary/20',
          ]}
          data-category={project.category}
        >
          <div class="flex items-start justify-between gap-3 mb-3">
            <div class="min-w-0">
              {project.featured && (
                <span class="inline-block px-2 py-0.5 mb-2 text-[10px] font-semibold uppercase tracking-wide rounded-full bg-primary/15 text-primary-light border border-primary/30">
                  Featured
                </span>
              )}
              <h3 class="text-lg font-bold text-white leading-snug">{project.title}</h3>
            </div>
            {project.link && (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-shrink-0 text-text-muted hover:text-primary transition-colors"
                aria-label={`Visit ${project.title} (opens in a new tab)`}
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </a>
            )}
          </div>
          {(formatRange(project.start, project.end) || project.org) && (
            <p class="text-text-muted text-xs mb-3">{formatRange(project.start, project.end) || project.org}</p>
          )}
          <p class="text-text-muted text-sm mb-4" set:html={highlight(project.desc)} />
          <p class="text-text-muted text-sm mb-4">
            <span class="text-primary font-medium">Frontend: </span>{project.contribution}
          </p>
          <div class="flex flex-wrap gap-2 mt-auto pt-1">
            {project.tags.map(tag => (
              <span class="px-2.5 py-1 text-xs rounded-full bg-primary/10 text-primary-light border border-primary/20">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('#projects [data-category]');
  const projectStatus = document.getElementById('project-status');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;

      filterButtons.forEach((btn) => {
        const isActive = btn === button;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });

      let visible = 0;
      projectCards.forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.style.display = show ? '' : 'none';
        if (show) {
          card.classList.add('active');
          visible += 1;
        }
      });

      if (projectStatus) {
        projectStatus.textContent = `${visible} project${visible === 1 ? '' : 's'} shown`;
      }
    });
  });
</script>
