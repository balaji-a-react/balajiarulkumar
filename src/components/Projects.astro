---

<section id="projects" class="py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-white text-center mb-4 reveal">
      Projects
    </h2>
    <div class="w-16 h-1 bg-primary mx-auto mb-12 reveal"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map(project => (
        <div class="glass-card p-6 flex flex-col reveal">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-lg font-bold text-white">{project.title}</h3>
            {project.link && (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-muted hover:text-primary transition-colors"
                aria-label={`Visit ${project.title}`}
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </a>
            )}
          </div>
          {(project.duration || project.org) && <p class="text-text-muted text-xs mb-3">{project.duration || project.org}</p>}
          <p class="text-text-muted text-sm mb-4 flex-1">{project.desc}</p>
          <div class="flex flex-wrap gap-2">
            {project.tags.map(tag => (
              <span class="px-2.5 py-1 text-xs rounded-full bg-primary/10 text-primary-light border border-primary/20">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
