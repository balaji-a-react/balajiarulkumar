---
const contacts = [
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>`,
    label: 'Email',
    value: 'balaji.arulkumar.dev@gmail.com',
    href: 'mailto:balaji.arulkumar.dev@gmail.com',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>`,
    label: 'Location',
    value: 'Coimbatore, Tamil Nadu',
    href: '',
  },
];
---

<section id="contact" class="py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-white text-center mb-4 reveal">
      Let's Work Together
    </h2>
    <div class="w-16 h-1 bg-primary mx-auto mb-6 reveal"></div>

    <p class="text-text-muted text-center max-w-xl mx-auto mb-12 reveal">
      I'm currently open to new opportunities. Whether you have a project in mind or just want to say hi — my inbox is always open.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-3xl mx-auto mb-10">
      {contacts.map(contact => (
        <div class="glass-card p-6 text-center reveal">
          <div class="text-primary mb-3 flex justify-center" set:html={contact.icon} />
          <h3 class="text-white font-semibold text-sm mb-1">{contact.label}</h3>
          {contact.href ? (
            <a
              href={contact.href}
              class="text-text-muted text-sm hover:text-primary transition-colors break-all"
            >
              {contact.value}
            </a>
          ) : (
            <p class="text-text-muted text-sm">{contact.value}</p>
          )}
        </div>
      ))}
    </div>

    <div class="text-center reveal">
      <a
        href="https://www.linkedin.com/in/balaji-a-react"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-primary hover:bg-primary-light text-white font-medium rounded-lg transition-colors duration-200"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        Connect on LinkedIn
      </a>
    </div>
  </div>
</section>
