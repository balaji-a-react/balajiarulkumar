---
const experiences = [
 
  {
    title: 'Associate Software Engineer',
    company: 'OX Software Private Limited',
    companyLink: 'https://www.oxsoftwares.com',
    duration: 'May 2024 – Dec 2025',
    location: 'Palani, Tamil Nadu',
    bullets: [
      'Developed and maintained responsive, production frontend modules across multiple company products using React.js and TypeScript.',
      'Built reusable UI components documented with Storybook, and integrated REST/GraphQL APIs to power real-time, data-driven interfaces.',
      'Participated in sprint planning, code reviews, and requirement-gathering discussions as part of cross-functional, agile teams, managing state with Zustand and Context API.',
    ],
    tags: ['React', 'TypeScript', 'Tailwind CSS', 'GraphQL', 'Zustand', 'Context API', 'Git', 'Storybook'],
  },
];
---

<section id="experience" class="py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-white text-center mb-4 reveal">
      Experience
    </h2>
    <div class="w-16 h-1 bg-primary mx-auto mb-12 reveal"></div>

    <div class="relative">
      <!-- Timeline Line -->
      <div class="timeline-line"></div>

      <div class="space-y-12">
        {experiences.map((exp, index) => (
          <div class={`relative flex flex-col md:flex-row gap-8 ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            <!-- Timeline dot -->
            <div class="absolute left-[16px] md:left-1/2 md:-translate-x-1/2 w-3 h-3 rounded-full bg-primary border-2 border-dark z-10 mt-6"></div>

            <!-- Spacer for alternating layout -->
            <div class="hidden md:block md:w-1/2"></div>

            <!-- Card -->
            <div class="ml-12 md:ml-0 md:w-1/2 reveal">
              <div class="glass-card p-6">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-2">
                  <h3 class="text-lg font-bold text-white">{exp.title}</h3>
                  <span class="text-sm text-text-muted">{exp.duration}</span>
                </div>
                {exp.companyLink ? (
                  <a
                    href={exp.companyLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-primary hover:text-primary-light transition-colors text-sm"
                  >
                    {exp.company}
                  </a>
                ) : (
                  <p class="text-primary text-sm mb-4">{exp.company}</p>
                )}
                {exp.location && <p class="text-text-muted text-xs mt-1 mb-4">{exp.location}</p>}

                <ul class="space-y-2 mb-4">
                  {exp.bullets.map(bullet => (
                    <li class="text-text-muted text-sm flex gap-2">
                      <span class="text-primary mt-1 flex-shrink-0">▹</span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>

                <div class="flex flex-wrap gap-2">
                  {exp.tags.map(tag => (
                    <span class="px-3 py-1 text-xs rounded-full bg-primary/10 text-primary-light border border-primary/20">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
