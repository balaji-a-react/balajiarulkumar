---
const monthLabel = (value: string) => {
  const [year, month] = value.split('-').map(Number);
  return new Date(year, month - 1).toLocaleString('en-US', { month: 'short', year: 'numeric' });
};

const monthsBetween = (start: string, end: string) => {
  const [startYear, startMonth] = start.split('-').map(Number);
  const [endYear, endMonth] = end.split('-').map(Number);
  return (endYear - startYear) * 12 + (endMonth - startMonth) + 1;
};

const formatDuration = (months: number) => {
  const years = Math.floor(months / 12);
  const remainder = months % 12;
  const parts: string[] = [];
  if (years) parts.push(`${years} ${years === 1 ? 'yr' : 'yrs'}`);
  if (remainder) parts.push(`${remainder} ${remainder === 1 ? 'mo' : 'mos'}`);
  return parts.join(' ');
};

const experiences = [
  {
    title: 'Independent Frontend Developer',
    company: 'Independent Projects',
    companyLink: '',
    start: '2026-01',
    end: '2026-09',
    location: 'Remote',
    bullets: [
      'Independently developed and delivered responsive websites using Astro, TypeScript, and Tailwind CSS, creating reusable UI components for client requirements.',
      'Implemented frontend features for an existing ERP application using React.js and TypeScript, including leave management workflows, REST API integration, and form validation.',
    ],
  },
  {
    title: 'Associate Software Engineer',
    company: 'OX Softwares Private Limited',
    companyLink: 'https://www.oxsoftwares.com',
    start: '2024-05',
    end: '2025-12',
    location: 'Palani, Tamil Nadu',
    bullets: [
      'Developed frontend features using React.js and TypeScript, building reusable components and customizing UI libraries for forms, data tables, dashboards, and business workflows.',
      'Integrated GraphQL queries and mutations using Apollo Client and REST APIs to support CRUD operations, handling asynchronous data states and managing shared state with Zustand and Context API.',
      'Collaborated with team members to understand business requirements, plan frontend implementations, and deliver features in coordination with backend developers.',
      'Diagnosed and resolved production issues involving responsive layouts, API data handling, form validation, component rendering, and frontend performance.',
    ],
  },
].map((exp) => ({
  ...exp,
  duration: `${monthLabel(exp.start)} – ${monthLabel(exp.end)} (${formatDuration(monthsBetween(exp.start, exp.end))})`,
}));
---

<section id="experience" class="py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-white text-center mb-4 reveal">
      Experience
    </h2>
    <div class="w-16 h-1 bg-primary mx-auto mb-12 reveal"></div>

    <div class="relative">
      <!-- Timeline Line -->
      <div class="timeline-line"></div>

      <div class="space-y-12">
        {experiences.map((exp, index) => (
          <div class={`relative flex flex-col md:flex-row gap-8 ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            <!-- Timeline dot -->
            <div class="absolute left-[16px] md:left-1/2 md:-translate-x-1/2 w-3 h-3 rounded-full bg-primary border-2 border-dark z-10 mt-6"></div>

            <!-- Spacer for alternating layout -->
            <div class="hidden md:block md:w-1/2"></div>

            <!-- Card -->
            <div class="ml-12 md:ml-0 md:w-1/2 reveal">
              <div class="glass-card p-6">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-2">
                  <h3 class="text-lg font-bold text-white">{exp.title}</h3>
                  <span class="text-sm text-text-muted whitespace-nowrap">{exp.duration}</span>
                </div>
                {exp.companyLink ? (
                  <a
                    href={exp.companyLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-primary hover:text-primary-light transition-colors text-sm"
                  >
                    {exp.company}
                  </a>
                ) : (
                  <p class="text-primary text-sm mb-4">{exp.company}</p>
                )}
                {exp.location && <p class="text-text-muted text-xs mt-1 mb-4">{exp.location}</p>}

                <ul class="space-y-2">
                  {exp.bullets.map(bullet => (
                    <li class="text-text-muted text-sm flex gap-2">
                      <span class="text-primary mt-1 flex-shrink-0">▹</span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
