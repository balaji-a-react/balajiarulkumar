---
const stats = [
  { value: '1.7+', label: 'Years Experience' },
  { value: '1', label: 'Company' },
  { value: '5', label: 'Projects Delivered' },
  { value: '10+', label: 'Tools & Technologies' },
];

const traits = [
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 01-.657.643 48.39 48.39 0 01-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 01-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 00-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 01-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 00.657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 01-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 005.427-.63 48.05 48.05 0 00.582-4.717.532.532 0 00-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.959.401v0a.656.656 0 00.658-.663 48.422 48.422 0 00-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 01-.61-.58v0z" /></svg>`,
    title: 'Component-First Thinker',
    desc: 'Building reusable, scalable UI components from day one',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>`,
    title: 'Performance Optimizer',
    desc: 'Refactoring codebases for speed, maintainability, and clarity',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" /></svg>`,
    title: 'API Integrator',
    desc: 'Seamlessly connecting UIs with REST APIs and GraphQL backends',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>`,
    title: 'Team Collaborator',
    desc: 'Leading and working within cross-functional agile teams',
  },
];
---

<section id="about" class="py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-white text-center mb-4 reveal">
      About Me
    </h2>
    <div class="w-16 h-1 bg-primary mx-auto mb-12 reveal"></div>

    <div class="flex flex-col lg:flex-row gap-12 items-start">
      <!-- Text -->
      <div class="flex-1 reveal">
        <p class="text-text-muted text-lg leading-relaxed">
          Agile Frontend Web Developer with 1.7+ years of experience crafting scalable and
          responsive web applications. Specialized in component-based development using React JS,
          JavaScript (ES6+), and modern CSS frameworks. Passionate problem solver focused on
          delivering clean, maintainable code and exceptional user experiences.
        </p>
      </div>

      <!-- Stats -->
      <div class="flex-1 grid grid-cols-2 gap-6 w-full reveal">
        {stats.map(stat => (
          <div class="text-center p-4 rounded-lg bg-dark-card border border-dark-border">
            <div class="text-3xl font-bold text-primary counter" data-target={stat.value}>0</div>
            <div class="text-text-muted text-sm mt-1">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Developer Traits -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-16">
      {traits.map(trait => (
        <div class="glass-card p-6 text-center reveal">
          <div class="text-primary mb-4 flex justify-center" set:html={trait.icon} />
          <h3 class="text-white font-semibold mb-2">{trait.title}</h3>
          <p class="text-text-muted text-sm">{trait.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
