---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Balaji Arulkumar | Frontend Web Developer",
  description = "Frontend Web Developer with 1.7+ years of experience crafting scalable and responsive web applications using React, TypeScript, and modern CSS frameworks."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/profile.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
